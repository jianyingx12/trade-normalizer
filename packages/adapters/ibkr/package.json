{
  "name": "@trade-normalizer/adapter-ibkr",
  "version": "0.0.0",
  "description": "Fixed-profile IBKR equity execution adapter for Trade Normalizer",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@trade-normalizer/core": "workspace:*",
    "csv-parse": "^7.0.2"
  }
}
