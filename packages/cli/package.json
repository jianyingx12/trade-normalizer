{
  "name": "@trade-normalizer/cli",
  "version": "0.0.0",
  "description": "CLI and high-level broker normalization API for Trade Normalizer",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo"
  ],
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    }
  },
  "bin": {
    "trade-normalizer": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@trade-normalizer/adapter-ibkr": "workspace:*",
    "@trade-normalizer/adapter-robinhood": "workspace:*",
    "@trade-normalizer/core": "workspace:*",
    "commander": "^15.0.0",
    "decimal.js": "^10.6.0"
  }
}
