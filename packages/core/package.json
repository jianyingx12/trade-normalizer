{
  "name": "@trade-normalizer/core",
  "version": "0.1.0",
  "description": "Broker-independent Trade Normalizer engine",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@trade-normalizer/schemas": "workspace:*",
    "decimal.js": "^10.6.0"
  }
}
